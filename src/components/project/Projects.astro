---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard';
import Header from '@/components/ui/Header';

const allProjects = await getCollection('projects');
const projects = allProjects
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 6);

const projectsData = projects.map((project) => ({
	title: project.data.title,
	desc: project.data.description,
	imageUrl: project.data.imageUrl,
	techStack: project.data.techStack,
	projectLink: project.data.projectLink,
	githubLink: project.data.githubLink,
	slug: project.slug
}));
---

<section class="projects-section flex flex-col gap-y-5 py-12" data-animate="true">
	<div class="projects-header" data-animate="fade-up">
		<Header size="large" gradient="gradient-3" center marginBottom="large" className="inline-block">
			Projects
		</Header>
	</div>

	<div class="projects-grid grid grid-cols-1 justify-center gap-8 md:grid-cols-2 lg:grid-cols-2">
		{
			projectsData.map((project, index) => (
				<div class="project-card-wrapper" data-animate="fade-up" data-delay={index * 0.1}>
					<ProjectCard
						client:load
						title={project.title}
						desc={project.desc}
						imageUrl={project.imageUrl}
						techStack={project.techStack}
						delay={index * 0.1}
					/>
				</div>
			))
		}
	</div>
</section>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const section = document.querySelector('.projects-section') as HTMLElement;
		const header = document.querySelector('.projects-header') as HTMLElement;
		const projectCards = document.querySelectorAll('.project-card-wrapper');

		// Create intersection observer for scroll-triggered animations
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const element = entry.target as HTMLElement;
						const delay = parseFloat(element.getAttribute('data-delay') || '0');

						setTimeout(() => {
							element.style.opacity = '1';
							element.style.transform = 'translateY(0) scale(1)';
							element.classList.add('animate-in');
						}, delay * 1000);

						observer.unobserve(element);
					}
				});
			},
			{
				threshold: 0.1,
				rootMargin: '0px 0px -50px 0px'
			}
		);

		// Initialize header animation
		if (header) {
			header.style.opacity = '0';
			header.style.transform = 'translateY(30px) scale(0.9)';
			header.style.transition = 'all 0.8s cubic-bezier(0.4, 0, 0.2, 1)';
			observer.observe(header);
		}

		// Initialize project cards
		projectCards.forEach((card, index) => {
			const htmlElement = card as HTMLElement;
			htmlElement.style.opacity = '0';
			htmlElement.style.transform = 'translateY(50px) scale(0.95)';
			htmlElement.style.transition = 'all 0.8s cubic-bezier(0.4, 0, 0.2, 1)';
			observer.observe(htmlElement);
		});

		// Set initial section state
		if (section) {
			section.style.opacity = '1';
			section.style.transform = 'translateY(0)';
		}
	});
</script>

<style>
	.projects-section {
		will-change: transform, opacity;
	}

	.project-card-wrapper {
		will-change: transform, opacity;
	}

	.project-card-wrapper.animate-in {
		animation: projectCardSlideIn 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
	}

	.projects-header.animate-in {
		animation: headerSlideIn 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
	}

	@keyframes projectCardSlideIn {
		0% {
			opacity: 0;
			transform: translateY(50px) scale(0.95);
		}
		50% {
			opacity: 0.8;
			transform: translateY(-5px) scale(1.02);
		}
		100% {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@keyframes headerSlideIn {
		0% {
			opacity: 0;
			transform: translateY(30px) scale(0.9);
		}
		100% {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}
</style>
