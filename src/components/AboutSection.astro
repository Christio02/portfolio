---
import { getEntry } from 'astro:content';
import Header from '@/components/ui/Header';

const aboutMe = await getEntry('pages', 'about-me');
const skills = await getEntry('pages', 'skills');
const { Content: AboutContent } = await aboutMe!.render();
const { Content: SkillsContent } = await skills!.render();
---

<section class="relative w-full py-16 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-24 sm:gap-32">
			<div class="content-block group relative w-full" data-animate="fade-right">
				<div
					class="from-card/20 via-card/10 absolute inset-0 rounded-3xl bg-gradient-to-br to-transparent opacity-0 backdrop-blur-sm transition-all duration-700 group-hover:opacity-100"
				>
				</div>

				<div
					class="from-primary/20 via-secondary/20 to-accent/20 absolute inset-0 rounded-3xl bg-gradient-to-r opacity-0 blur-xl transition-all duration-700 group-hover:opacity-60"
				>
				</div>

				<div
					class="from-card/5 group-hover:border-primary/20 group-hover:from-card/10 relative z-10 rounded-3xl border border-transparent bg-gradient-to-br to-transparent p-8 backdrop-blur-sm transition-all duration-700 sm:p-12"
				>
					<div
						class="from-primary via-secondary to-accent mb-8 h-px w-24 bg-gradient-to-r opacity-60 transition-all duration-700 group-hover:w-32 group-hover:opacity-100"
					>
					</div>

					<Header size="medium" gradient="gradient-2" marginBottom="medium">
						{aboutMe?.data.title}
					</Header>

					<div
						class="prose prose-lg text-foreground/80 group-hover:text-foreground/90 max-w-none transition-colors duration-300 [&>p]:mb-6 [&>p]:leading-relaxed"
					>
						<AboutContent />
					</div>
				</div>
			</div>

			<div class="content-block group relative w-full" data-animate="fade-left">
				<div
					class="from-card/20 via-card/10 absolute inset-0 rounded-3xl bg-gradient-to-bl to-transparent opacity-0 backdrop-blur-sm transition-all duration-700 group-hover:opacity-100"
				>
				</div>

				<div
					class="from-accent/20 via-secondary/20 to-primary/20 absolute inset-0 rounded-3xl bg-gradient-to-l opacity-0 blur-xl transition-all duration-700 group-hover:opacity-60"
				>
				</div>

				<div
					class="from-card/5 group-hover:border-accent/20 group-hover:from-card/10 relative z-10 rounded-3xl border border-transparent bg-gradient-to-bl to-transparent p-8 backdrop-blur-sm transition-all duration-700 sm:p-12"
				>
					<div
						class="from-accent via-secondary to-primary mb-8 ml-auto h-px w-24 bg-gradient-to-l opacity-60 transition-all duration-700 group-hover:w-32 group-hover:opacity-100"
					>
					</div>

					<Header size="medium" gradient="gradient-2" marginBottom="medium">
						{skills?.data.title}
					</Header>

					<div
						class="prose prose-lg text-foreground/80 group-hover:text-foreground/90 max-w-none transition-colors duration-300 [&>p]:mb-6 [&>p]:leading-relaxed"
					>
						<SkillsContent />
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const contentBlocks = document.querySelectorAll('.content-block');

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const element = entry.target as HTMLElement;
						const animationType = element.getAttribute('data-animate');

						element.classList.add('animate-in');

						if (animationType === 'fade-right') {
							element.style.transform = 'translateX(0) translateY(0) scale(1)';
							element.style.opacity = '1';
						} else if (animationType === 'fade-left') {
							element.style.transform = 'translateX(0) translateY(0) scale(1)';
							element.style.opacity = '1';
						}

						observer.unobserve(element);
					}
				});
			},
			{
				threshold: 0.1,
				rootMargin: '0px 0px -50px 0px'
			}
		);

		contentBlocks.forEach((block) => {
			const htmlElement = block as HTMLElement;
			const animationType = block.getAttribute('data-animate');

			htmlElement.style.opacity = '0';
			htmlElement.style.transition = 'all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
			htmlElement.style.willChange = 'transform, opacity';

			if (animationType === 'fade-right') {
				htmlElement.style.transform = 'translateX(-60px) translateY(30px) scale(0.95)';
			} else if (animationType === 'fade-left') {
				htmlElement.style.transform = 'translateX(60px) translateY(30px) scale(0.95)';
			}

			observer.observe(htmlElement);
		});

		let ticking = false;

		const updateParallax = () => {
			const scrolled = window.pageYOffset;
			const parallax = scrolled * 0.02;

			contentBlocks.forEach((block, index) => {
				const htmlElement = block as HTMLElement;
				const offset = index % 2 === 0 ? parallax : -parallax;
				htmlElement.style.transform += ` translateY(${offset}px)`;
			});

			ticking = false;
		};

		const requestTick = () => {
			if (!ticking) {
				requestAnimationFrame(updateParallax);
				ticking = true;
			}
		};

		window.addEventListener('scroll', requestTick, { passive: true });
	});
</script>

<style>
	.content-block {
		transform-origin: center;
	}

	.content-block.animate-in {
		animation: smoothSlideIn 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
	}

	@keyframes smoothSlideIn {
		0% {
			opacity: 0;
			transform: translateY(40px) scale(0.95);
		}
		60% {
			opacity: 0.8;
			transform: translateY(-5px) scale(1.01);
		}
		100% {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	.content-block:hover {
		transform: translateY(-2px) scale(1.001);
	}

	@media (max-width: 640px) {
		.content-block {
			margin: 0 -1rem;
		}
	}

	.prose h1,
	.prose h2,
	.prose h3,
	.prose h4,
	.prose h5,
	.prose h6 {
		color: hsl(var(--foreground));
	}

	.prose strong {
		color: hsl(var(--primary));
		font-weight: 600;
	}

	.prose ul,
	.prose ol {
		color: hsl(var(--foreground) / 0.8);
	}

	.prose li {
		color: hsl(var(--foreground) / 0.8);
		margin-bottom: 0.5rem;
	}

	.prose code {
		color: hsl(var(--accent));
		background-color: hsl(var(--accent) / 0.1);
		border-radius: 0.25rem;
		padding: 0.125rem 0.5rem;
		font-size: 0.875rem;
	}
</style>
